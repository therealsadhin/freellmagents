{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "freellmagents",
  "compatibility_date": "2026-09-25",
  // worker.ts serves the SPA shell only for real routes and returns genuine
  // 404s for unknown paths (soft-404 fix, see SEO-AUDIT.md).
  "main": "worker.ts",
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "not_found_handling": "none"
  }
}
